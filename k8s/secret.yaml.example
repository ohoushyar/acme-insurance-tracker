# Copy to secret.yaml and apply. Do not commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: insurance-tracker
  labels:
    app: insurance-tracker
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://app:change-me@postgres:5432/insurance
  ADMIN_DATABASE_URL: postgresql+asyncpg://postgres:change-me@postgres:5432/insurance
  REDIS_URL: redis://redis:6379/0
  DRAMATIQ_REDIS_URL: redis://redis:6379/2
  POSTGRES_PASSWORD: change-me
  APP_DB_PASSWORD: change-me
  S3_ACCESS_KEY: change-me
  S3_SECRET_KEY: change-me
  OPENROUTER_API_KEY: change-me
