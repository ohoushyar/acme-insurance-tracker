# Copy to .env for local uvicorn + vite. Compose uses the values below by default.
# Never commit real secrets.

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/insurance
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insurance
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
LOG_LEVEL=info
